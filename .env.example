# ============================================================================
# Ventuno Q Smart Home Voice Assistant Configuration (.env)
# Copy this file to `.env` and fill in your Home Assistant Long-Lived Token.
# ============================================================================

# Home Assistant Local API Configuration
# Use http://host.docker.internal:8123 or your Ventuno Q's LAN IP (e.g. http://192.168.1.50:8123)
HA_URL=http://host.docker.internal:8123
HA_TOKEN=replace_with_your_home_assistant_long_lived_access_token
HA_TIMEOUT_SEC=3.0

# Timezone for local time injection into the LLM
TIMEZONE=America/Los_Angeles

# Audio & Voice Pipeline Defaults (Wake word is auto-detected from the configured model)
KEYWORD_CONFIDENCE=0.90
KEYWORD_DEBOUNCE_SEC=2.0
ALSA_PLAYBACK_DEVICE=plughw:1,0
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG=en-us
